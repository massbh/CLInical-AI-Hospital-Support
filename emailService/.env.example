# Database
DATABASE_URL=postgresql://clinicalai:clinicalai@localhost:5432/clinicalai

# API Keys (comma-separated) — used by the manual /send-report route
API_KEYS=your-api-key-here

# Gmail SMTP
# 1. Enable 2-Step Verification on the Google Account.
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password (not your account password) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your@gmail.com
SMTP_USE_TLS=true

# Email poller — finds finalized reports and emails them
EMAIL_POLL_INTERVAL_SECONDS=60
EMAIL_SCHEDULER_ENABLED=true

# Force every email to a fixed address (useful while testing). Leave blank to
# send to the patient's real email.
EMAIL_RECIPIENT_OVERRIDE=

# Where to fetch the finalized PDF from
REPORT_GENERATOR_URL=http://localhost:8004
REPORT_GENERATOR_TIMEOUT_SECONDS=30
