# Report Generator Service Configuration

# Service Port
# Default: 8004 (avoiding port conflict with tradLlm:8002)
SERVICE_PORT=8004

# API Key for authentication
# Used in X-API-Key header for /process-reports and /scheduler/status endpoints
API_KEY=your-secret-key

# Database Connection
# Format: postgresql://user:password@host:port/database
# Must match credentials in database/docker-compose.yml
DATABASE_URL=postgresql://clinicalai:clinicalai@localhost:5432/clinicalai

# PDF Output Directory
PDF_OUTPUT_DIR=reports/

# Preview UI Endpoint
# Where to send reports for preview before PDF generation
# Endpoint path: POST /api/reports/{id}
PREVIEW_UI_ENDPOINT=http://localhost:3000/api/reports

# Scheduler Configuration
# How often to process pending reports (in seconds)
# Development: 60 (1 minute) for faster testing
# Production: 3600 (1 hour)
SCHEDULER_INTERVAL_SECONDS=3600

# Enable/disable the background scheduler
# Set to 'false' to disable automatic processing
SCHEDULER_ENABLED=true

# HTTP Request Timeouts (in seconds)
PREVIEW_UI_TIMEOUT_SECONDS=10.0

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
